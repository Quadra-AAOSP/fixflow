# Copy to .env and fill in your local values
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Bootstrap super-admin
FIXFLOW_SUPER_ADMIN_EMAIL=
FIXFLOW_SUPER_ADMIN_PASSWORD=

# MinIO
MINIO_ENDPOINT=
# Browser/phone reachable endpoint for signed download URLs (not Docker's service hostname).
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# Docker stack only. The MySQL application account must NOT be root.
MYSQL_ROOT_PASSWORD=
MYSQL_HOST_PORT=3307
MINIO_HOST_PORT=9000
MINIO_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
# Default loopback; set a deliberate LAN binding only for trusted local testing.
BACKEND_BIND_ADDRESS=127.0.0.1
# Production override requires an approved image and separately provisioned app credentials.
MINIO_IMAGE=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# OpenRouter AI
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_RANKING_ENABLED=false
OPENROUTER_RANKING_MODEL=openrouter/free
OPENROUTER_RANKING_TIMEOUT_SECONDS=15
OPENROUTER_VISION_ENABLED=false
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_VISION_FALLBACK_MODEL=minimax/minimax-m3.1-flash:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2
OPENROUTER_RETRY_BACKOFF_SECONDS=1
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=1000
# Secure by default; set false ONLY when developing over local HTTP.
SESSION_COOKIE_SECURE=true
# LAN development: allow the exact browser origin, not all origins.
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
SERVER_ADDRESS=0.0.0.0
# Exact browser/native WebSocket origins; no wildcard or trailing slash.
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
WEBSOCKET_SESSION_CHECK_MS=5000
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h

# Supply approved, immutable terms before enabling enforcement.
TECHNICIAN_TERMS_VERSION=
TECHNICIAN_TERMS_DOCUMENT_URL=
TECHNICIAN_TERMS_REQUIRED=false
REPORTING_REQUIRE_SITE_SETUP=true
# Shop (SGD minor units; shipping = 500 => S$5.00)
SHOP_CURRENCY=SGD
SHOP_MINOR_UNIT_DIGITS=2
SHOP_FLAT_SHIPPING_MINOR=500
SHOP_CHECKOUT_SUCCESS_URL=http://localhost:5173/shop
SHOP_CHECKOUT_CANCEL_URL=http://localhost:5173/shop
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# DEVELOPMENT ONLY: SQL sample data, with each new user's password = email.
# Never enable on a production database. No profiles are needed.
SEED_DEMO_DATA=false

# Per-backend-instance fixed-window limits. Configure a shared gateway for replicas.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_AUTHENTICATION=20
RATE_LIMIT_WRITES=120
RATE_LIMIT_AI=10
RATE_LIMIT_TOKEN_BOOTSTRAP=240
RATE_LIMIT_MAX_BUCKETS=10000
