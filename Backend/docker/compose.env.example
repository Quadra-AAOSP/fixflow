# LOCAL DOCKER ONLY. Copy outside Git and replace every CHANGE_ME value.
# Do not reuse the native backend's DB_USER=root or its database password.
DB_NAME=fixflow
DB_USER=fixflow
DB_PASSWORD=CHANGE_ME_application_database_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_separate_database_root_password
MINIO_ACCESS_KEY=fixflow-local-storage
MINIO_SECRET_KEY=CHANGE_ME_local_storage_password
MINIO_BUCKET=fixflow-photos
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
FIXFLOW_SUPER_ADMIN_EMAIL=admin@fixflow.local
FIXFLOW_SUPER_ADMIN_PASSWORD=CHANGE_ME_bootstrap_password
SESSION_COOKIE_SECURE=false
BACKEND_PORT=8080
BACKEND_BIND_ADDRESS=127.0.0.1
MYSQL_HOST_PORT=3307
MINIO_HOST_PORT=9000
MINIO_BIND_ADDRESS=127.0.0.1
SEED_DEMO_DATA=false
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://localhost:8081
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
