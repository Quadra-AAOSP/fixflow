# Blank: web uses its browser hostname; Expo LAN uses the development PC's host.
# Start Expo with --lan; phone and PC must be on the same network.
# Set explicitly for production, tunnels, or a backend on another PC.
#
# REQUIRED for release builds: `constants/config.ts` throws at startup when
# __DEV__ is false and this is unset. Point it at the deployed backend origin
# (https in production). No secrets belong in this file or any EXPO_PUBLIC_*
# variable — they are embedded in the JS bundle. Session tokens are issued at
# runtime by the backend.
EXPO_PUBLIC_API_URL=

# WebSocket Origin header for native builds (backend allow-lists it).
# Must match an entry in the backend `fixflow.websocket.allowed-origins`.
EXPO_PUBLIC_WS_ORIGIN=
